##### 6.2 Calculate cluster proportions by sample ####
meta <- CCAIntegration_obj@meta.data

cluster_sample_prop_by_cluster <- meta %>%
  count(seurat_clusters, orig.ident, name = "cell_number") %>%
  group_by(seurat_clusters) %>%
  mutate(
    cluster_total = sum(cell_number),
    prop_in_cluster = cell_number / cluster_total
  ) %>%
  ungroup()

cluster_sample_count_matrix <- table(
  CCAIntegration_obj$seurat_clusters,
  CCAIntegration_obj$orig.ident
)

cluster_sample_prop_matrix_by_sample <- prop.table(
  cluster_sample_count_matrix,
  margin = 2
)

cluster_sample_prop_by_sample <- meta %>%
  count(orig.ident, seurat_clusters, name = "cell_number") %>%
  group_by(orig.ident) %>%
  mutate(
    sample_total = sum(cell_number),
    prop_in_sample = cell_number / sample_total
  ) %>%
  ungroup()

cluster_sample_prop_by_sample$seurat_clusters <- as.character(cluster_sample_prop_by_sample$seurat_clusters) %>% factor(., levels = 0:24)

ggplot(cluster_sample_prop_by_sample,
       aes(x = orig.ident, y = prop_in_sample, fill = seurat_clusters)) +
  geom_bar(stat = "identity", position = "fill") +
  theme_classic() +
  labs(
    x = "orig.ident",
    y = "Proportion within sample",
    fill = "Cluster"
  )

##### 6.3 Assign final cell-type labels ####
CCAIntegration_obj$celltype <- case_when(
  CCAIntegration_obj$seurat_clusters %in% 
    c(0, 1, 2, 3, 4, 6, 9, 10, 11, 15, 16, 19, 21, 22) ~ "mOSN",
  CCAIntegration_obj$seurat_clusters %in% c(5, 24) ~ "iOSN",
  CCAIntegration_obj$seurat_clusters %in%  c(7,8) ~ "INP",
  CCAIntegration_obj$seurat_clusters %in%  c(12, 13) ~ "GBC",
  CCAIntegration_obj$seurat_clusters == 14 ~ "HBC",
  CCAIntegration_obj$seurat_clusters == 23 ~ "MV",
  CCAIntegration_obj$seurat_clusters == 20  ~ "Trpm5+ MV",
  CCAIntegration_obj$seurat_clusters %in%  c(17, 18) ~ "Immune cell",
  TRUE ~ NA_character_
)

CCAIntegration_obj$celltype <- factor(CCAIntegration_obj$celltype, 
                                      levels = c("mOSN", "iOSN", "INP", "GBC", "HBC", 
                                                 "MV", "Trpm5+ MV",
                                                 "Immune cell"))

save(CCAIntegration_obj, file = "integrated_analysis_seuratV5_Datta_data/rdata/CCAIntegration_obj_celltype.rdata")

