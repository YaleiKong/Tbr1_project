################################################################################
#### 10. Train and evaluate the linear SVM TAAR/OR classifier ####
#### This independent block deliberately clears the environment and reloads the
#### saved single-receptor mOSN object. Its original random seed is retained.
################################################################################
rm(list=ls())
## Load packages used by the SVM training and evaluation workflow.
.libPaths(new = "/lustre/home/acct-medlqian/medlqian-loop3/R/x86_64-redhat-linux-gnu-library/4.2.2")

# install.packages("LiblineaR")
# install.packages("e1071")
# install.packages("caret")   # 混淆矩阵、训练辅助

library(LiblineaR)
library(e1071)
# library(caret)
library(pROC)
library(PRROC)

library(Seurat) # 文章中用的v4.1.0
library(ggplot2)
library(scales)
library(dplyr)
library(tidyr)
library(purrr) 
library(tidyverse) 
library(stringr)
library(RColorBrewer)
library(patchwork)
library(colorspace) # darken
library(harmony)
library(ggvenn)
library(Matrix)
library(clustree)
library(ComplexUpset)
library(openxlsx)

set.seed(1)

##### 10.1 Load the training object and define TAAR/OR labels ####
# 提取WT单细胞数据中的表达单个受体的mOSN
load("../20250518_WT_10X_scRNA_Seq_seurat_analysis/integrated_analysis_seuratV5_Datta_data/rdata/mOSN_scRNA_single_receptor.rdata")

# 不区分 class I OR 和 class II OR
mOSN_scRNA_single_receptor$Taar_OR_class <- ifelse(
  mOSN_scRNA_single_receptor$receptor_class == "Taar",
  "Taar",
  "OR"
)

Idents(mOSN_scRNA_single_receptor) <- "Taar_OR_class"

##### 10.2 Recreate the stratified training and test sets ####
meta <- mOSN_scRNA_single_receptor@meta.data
meta$cell_id <- rownames(meta)
meta$label <- mOSN_scRNA_single_receptor$Taar_OR_class

## Stratify jointly by sample identity and TAAR/OR label.
meta$strata <- paste(meta$orig.ident, meta$label, sep = "_")

## Sample 80% of cells from each stratum for model training.
train_cells <- unlist(lapply(split(meta$cell_id, meta$strata), function(cells) {
  n <- length(cells)
  
  n_train <- max(1, min(n - 1, floor(0.8 * n)))
  
  return(sample(cells, size = n_train))
}))
# split(meta$cell_id, meta$strata) 这一步是把所有细胞按 meta$strata 分组。
# lapply(..., function(cells) { ... }) 对每一个分组，分别执行后面的抽样函数。

test_cells <- setdiff(meta$cell_id, train_cells)

## Confirm label and receptor-class distributions in both partitions.
table(meta[train_cells, "label"])
# OR  Taar 
# 35330   462 
table(meta[train_cells, "receptor_class"])
# Class_I_OR Class_II_OR        Taar 
# 3496       31834         462
table(meta[test_cells, "label"])
# OR Taar 
# 8836  117 

##### 10.3 Reuse the training-set DEG feature list ####
## The feature list was generated in Section 9.3 using training cells only.

##### 10.4 Extract the normalized expression matrix ####
train_markers_use <- read.xlsx("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/files/Taar_OR_train_only_DE_results_mOSN_expressing_single_receptor.xlsx",
                               sheet = "train_markers_filtered")

features <- train_markers_use$gene

length(features)
# 267

mat <- GetAssayData(mOSN_scRNA_single_receptor, assay = "SCT", layer = "data")

features <- unique(na.omit(train_markers_use$gene))
features_exclude_Tbr1 <- setdiff(features, "Tbr1")
length(features_exclude_Tbr1)
# 266

##### 10.5 Construct training and test feature matrices ####
# 把表达矩阵变成 cells × genes，符合 svm 输入格式
x1_train <- t(as.matrix(mat[features_exclude_Tbr1, train_cells]))
x1_test  <- t(as.matrix(mat[features_exclude_Tbr1, test_cells]))

## Remove genes with zero variance in the training set and apply the same filter
## to the test matrix.
keep <- apply(x1_train, 2, function(z) sd(z) > 0)
x1_train <- x1_train[, keep, drop = FALSE]
x1_test  <- x1_test[, keep, drop = FALSE]

dim(x1_train)
# 35792   266

##### 10.6 Encode SVM class labels ####
y_train <- ifelse(meta[train_cells, "label"] == "Taar", 1, -1)

y_test  <- ifelse(meta[test_cells, "label"] == "Taar", 1, -1)

##### 10.7 Standardize features using training-set statistics ####
# SVM 对特征尺度敏感。e1071::svm() 默认会做缩放；如果你用 LiblineaR，通常自己先标准化更稳妥。e1071 文档也明确说明其默认会对变量做 scaling。
# 因为 SVM（以及很多基于距离/内积的模型）对特征尺度很敏感，先标准化是为了让每个基因在模型里处于可比较的量纲，避免某些数值范围大的基因不成比例地支配分类边界。
# 标准化后，每个基因都被拉到类似尺度，模型才更公平地比较它们的贡献。

# 本质上是在做每个基因的 z-score 标准化：标准化后均值变成 0 标准化后标准差变成 1
train_center <- colMeans(x1_train)
train_scale  <- apply(x1_train, 2, sd)
train_scale[train_scale == 0] <- 1

x_train_sc <- scale(x1_train, center = train_center, scale = train_scale)
x_test_sc  <- scale(x1_test,  center = train_center, scale = train_scale)

##### 10.8 Select the cost parameter by stratified cross-validation ####
## Compare mean accuracy and F1 score across candidate cost values.

## Construct stratified five-fold assignments.
set.seed(42)

nfolds <- 5
fold_id <- rep(NA_integer_, length(y_train))

# 正类：TAAR = 1
idx_pos <- which(y_train == 1)

fold_id[idx_pos] <- sample(
  rep(seq_len(nfolds), length.out = length(idx_pos))
)

# 负类：OR = -1
idx_neg <- which(y_train == -1)

fold_id[idx_neg] <- sample(
  rep(seq_len(nfolds), length.out = length(idx_neg))
)

# 检查每折类别分布
print(table(fold_id, y_train))

print(
  prop.table(
    table(fold_id, y_train),
    margin = 1
  )
)

## Perform stratified five-fold cross-validation for each cost value.
cost_grid <- c(0.01, 0.1, 1, 10, 100)

cv_acc <- numeric(length(cost_grid))
cv_f1  <- numeric(length(cost_grid))

for (i in seq_along(cost_grid)) {
  
  cv_cost_i <- cost_grid[i]
  
  # 每个 cost 都重新初始化
  cv_fold_acc <- numeric(nfolds)
  cv_fold_f1  <- numeric(nfolds)
  
  for (k in seq_len(nfolds)) {
    
    cv_train_idx <- which(fold_id != k)
    cv_valid_idx <- which(fold_id == k)
    
    # 只用当前交叉验证训练折计算均值和标准差
    cv_center_k <- colMeans(
      x1_train[cv_train_idx, , drop = FALSE]
    )
    
    cv_scale_k <- apply(
      x1_train[cv_train_idx, , drop = FALSE],
      2,
      sd
    )
    
    cv_scale_k[is.na(cv_scale_k) | cv_scale_k == 0] <- 1
    
    # 当前 CV 训练折标准化
    x_cv_train_sc <- scale(
      x1_train[cv_train_idx, , drop = FALSE],
      center = cv_center_k,
      scale  = cv_scale_k
    )
    
    # 当前 CV 验证折使用训练折的均值和标准差
    x_cv_valid_sc <- scale(
      x1_train[cv_valid_idx, , drop = FALSE],
      center = cv_center_k,
      scale  = cv_scale_k
    )
    
    # 当前折模型
    cv_fit_k <- LiblineaR(
      data   = x_cv_train_sc,
      target = y_train[cv_train_idx],
      type   = 1,
      cost   = cv_cost_i,
      bias   = TRUE
    )
    
    # 当前折预测
    cv_pred_k <- predict(
      cv_fit_k,
      x_cv_valid_sc
    )
    
    cv_y_pred <- cv_pred_k$predictions
    cv_y_true <- y_train[cv_valid_idx]
    
    # Accuracy
    cv_fold_acc[k] <- mean(cv_y_pred == cv_y_true)
    
    # 将 TAAR = 1 作为正类
    cv_TP <- sum(cv_y_pred == 1  & cv_y_true == 1)
    cv_FP <- sum(cv_y_pred == 1  & cv_y_true == -1)
    cv_FN <- sum(cv_y_pred == -1 & cv_y_true == 1)
    
    cv_precision <- ifelse(
      cv_TP + cv_FP == 0,
      0,
      cv_TP / (cv_TP + cv_FP)
    )
    
    cv_recall <- ifelse(
      cv_TP + cv_FN == 0,
      0,
      cv_TP / (cv_TP + cv_FN)
    )
    
    cv_fold_f1[k] <- ifelse(
      cv_precision + cv_recall == 0,
      0,
      2 * cv_precision * cv_recall /
        (cv_precision + cv_recall)
    )
  }
  
  cv_acc[i] <- mean(cv_fold_acc)
  cv_f1[i]  <- mean(cv_fold_f1)
}


## Select the cost with the highest mean cross-validation F1 score.
cv_result <- data.frame(
  cost   = cost_grid,
  cv_acc = cv_acc,
  cv_f1  = cv_f1
)

print(cv_result)
# cost    cv_acc     cv_f1
# 1 1e-02 0.9961164 0.8349462
# 2 1e-01 0.9959488 0.8359075
# 3 1e+00 0.9939931 0.7716677
# 4 1e+01 0.9927078 0.7308418
# 5 1e+02 0.9922049 0.7193910

# 按平均 F1 选择最佳 cost
best_cost <- cost_grid[which.max(cv_f1)]

print(best_cost)
# 0.1
##### 10.9 Train and save the final model using the selected cost ####
final_svm <- LiblineaR(
  data   = x_train_sc,
  target = y_train,
  type   = 1,
  cost   = best_cost,
  bias   = TRUE
)
saveRDS(final_svm, file = "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/final_svm_model.rds")

svm_bundle <- list(
  model = final_svm,
  features = colnames(x_train_sc),
  center = train_center,
  scale = train_scale,
  positive_class = 1,
  negative_class = -1,
  best_cost = best_cost
)

saveRDS(
  svm_bundle,
  file = "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/final_svm_model_info.rds"
)

## Extract and rank linear SVM feature weights.
w_raw <- as.vector(final_svm$W)
n_gene <- ncol(x_train_sc)

if (length(w_raw) == n_gene + 1) {
  gene_weight <- w_raw[seq_len(n_gene)]
  bias_weight <- w_raw[n_gene + 1]
} else if (length(w_raw) == n_gene) {
  gene_weight <- w_raw
  bias_weight <- NA_real_
} else {
  stop(
    "SVM weight number is unexpected: ",
    length(w_raw),
    "; gene number = ",
    n_gene
  )
}

weight_df <- data.frame(
  gene = colnames(x_train_sc),
  weight = gene_weight
)

weight_df <- weight_df[
  order(abs(weight_df$weight), decreasing = TRUE),
]

write.csv(
  weight_df,
  file = paste0(
    "integrated_analysis_seuratV5_Datta_data/",
    "TAAR_OR_OSN_identifier_model/",
    "linear_SVM_genes_weight.csv"
  ),
  row.names = FALSE
)

bias_weight

##### 10.10 Predict and evaluate the held-out test set ####
final_svm <- readRDS("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/final_svm_model.rds")
pred_test <- predict(final_svm, x_test_sc, decisionValues = TRUE)

pred_label <- pred_test$predictions

conf_mat <- table(Pred = pred_label, True = y_test)
conf_mat
# True
# Pred   -1    1
# -1 8827   15
# 1     9  102

## Confusion-matrix plot
conf_df <- as.data.frame(conf_mat)

conf_df_prop <- conf_df %>%
  group_by(True) %>%
  mutate(prop = Freq / sum(Freq),
         label = paste0(Freq, "\n", round(prop * 100, 1), "%"))

pdf("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/plots/SVM_prediction_WT_test_mOSN.pdf")
ggplot(conf_df_prop, aes(x = True, y = Pred, fill = prop)) +
  geom_tile(color = "white") +
  geom_text(aes(label = label), size = 5) +
