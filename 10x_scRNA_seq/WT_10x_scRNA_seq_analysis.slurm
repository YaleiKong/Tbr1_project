## Cell-type composition bar plot
plot_df <- CCAIntegration_obj@meta.data %>%
  dplyr::select(orig.ident, celltype) %>%
  dplyr::filter(!is.na(celltype), !is.na(orig.ident)) %>%
  dplyr::count(orig.ident, celltype) %>%
  dplyr::group_by(orig.ident) %>%
  dplyr::mutate(percent = n / sum(n) * 100) %>%
  dplyr::ungroup()

pdf(file = "integrated_analysis_seuratV5_Datta_data/plots/barplot_celltype_prop.pdf", width = 10, height = 6)
ggplot(plot_df, aes(x = orig.ident, y = percent, fill = celltype)) +
  geom_bar(stat = "identity", width = 0.75) +
  scale_fill_manual(values = celltype_cols) +
  theme_classic(base_size = 14) +
  labs(
    x = NULL,
    y = "Cell proportion (%)",
    fill = "Cell type"
  ) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.title = element_text(size = 12),
    legend.text = element_text(size = 11)
  )
dev.off()

## Marker-gene violin plots
markers_to_plot <- c("Omp", "Gnal", "Gap43", "Dpysl3", "Tex15", "Neurog1", "Neurod1", "Ascl1", "Krt5","Krt14", "Hepacam2", "Ascl3", "Trpm5", "Cd37")

## Generate one violin plot per marker and combine them into a single column.
p_list <- VlnPlot(
  CCAIntegration_obj,
  features = markers_to_plot,
  group.by = "celltype",      # 如果你的 Idents 已经是 celltype，可以去掉这一行
  cols = celltype_cols,       # 如果没有自定义颜色，可以去掉
  pt.size = 0,
  ncol = 1,
  combine = FALSE
)

p_list <- lapply(seq_along(p_list), function(i) {
  
  p <- p_list[[i]] +
    theme_classic(base_size = 12) +
    labs(x = NULL, y = NULL) +
    theme(
      legend.position = "none",
      plot.title = element_text(
        size = 12,
        face = "bold",
        hjust = 0.5
      ),
      axis.text.y = element_text(size = 9, color = "black"),
      axis.ticks.y = element_line(linewidth = 0.3),
      axis.line = element_line(linewidth = 0.4),
      plot.margin = margin(2, 5, 2, 5)
    )
  
  # 只有最后一行显示 celltype
  if (i != length(p_list)) {
    p <- p +
      theme(
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank()
      )
  } else {
    p <- p +
      theme(
        axis.text.x = element_text(
          angle = 45,
          hjust = 1,
          vjust = 1,
          size = 10,
          color = "black"
        ),
        axis.ticks.x = element_line(linewidth = 0.3)
      )
  }
  
  p
})

pdf("integrated_analysis_seuratV5_Datta_data/plots/vlnplot_markers_celltype_one_column.pdf",
    width = 7,
    height = 0.8 * length(markers_to_plot))

wrap_plots(p_list, ncol = 1)

dev.off()

## Marker-gene dot plot
pdf("integrated_analysis_seuratV5_Datta_data/plots/dotplot_markers_celltype.pdf",
    width = 7, height = 5)
DotPlot(CCAIntegration_obj, features = markers_to_plot) + 
  RotatedAxis() + 
  scale_color_gradient(low = "grey90", high = "#3a78d7") +
  scale_y_discrete(limits = rev)
dev.off()

#### 7. Determine the receptor-expression UMI threshold in mOSNs ####
## Compile protein-coding Taar and Olfr genes used to identify the receptor
## expressed by each mature OSN.
gene_info <- read.delim("/lustre/home/acct-medlqian/share/Database/Reference/Mus_musculus/GRCm38_mm10/Annotation_gtf_files/Genes_extracted_from_gencode.vM25.Comprehensive.gtf.file_modified_final.txt", header = T)
receptor_info <- gene_info[grepl("Taar|Olfr", gene_info$gene_name) & grepl("protein_coding", gene_info$gene_type),]
receptor_name <- receptor_info$gene_name
length(receptor_name)
# 1155

## Extract mOSNs and retain only the SCT counts and normalized-data layers.
load("integrated_analysis_seuratV5_Datta_data/rdata/CCAIntegration_obj_celltype.rdata")
Idents(CCAIntegration_obj) <- "celltype"
table(CCAIntegration_obj$celltype)

mOSN_diet_scRNA <- DietSeurat(
  object = subset(CCAIntegration_obj, idents = "mOSN"),
  assays = "SCT",
  layers = c("counts", "data")   
)
# DietSeurat
# Save memory
# Reduce file size for sharing/saving
# Speed up processing
# Focus only on specific components of the data

mOSN_diet_scRNA
# An object of class Seurat 
# 22165 features across 51216 samples within 1 assay 
# Active assay: SCT (22165 features, 3000 variable features)
# 2 layers present: counts, data

## Obtain the receptor UMI-count matrix used for threshold evaluation.
mOSN_olfr_counts <- FetchData(
  object = mOSN_diet_scRNA,
  vars = receptor_name,
  layer = "counts"
)
# Warning message:
#   The following requested variables were not found (10 out of 103 shown): Olfr248, Olfr340, Olfr345, Olfr993, Olfr154, Olfr1008, Olfr1022, Olfr1024, Olfr1040, Olfr1049 

dim(mOSN_olfr_counts)
# 51216  1049

calculate_mOSNs_percentage <- function(cutoff){
  if(cutoff==0){
    each_cell_expressed_Olfr_N <- rowSums(mOSN_olfr_counts>cutoff)
  } else {
    each_cell_expressed_Olfr_N <- rowSums(mOSN_olfr_counts>=cutoff)
  }
  zero_Olfr_percentage <- mean(each_cell_expressed_Olfr_N==0)*100
  one_Olfr_percentage <- mean(each_cell_expressed_Olfr_N==1)*100
  more_than_one_Olfr_percentage <- mean(each_cell_expressed_Olfr_N>1)*100
  mOSN_df <- data.frame(cutoff=cutoff,Olfr_N=c("0","1",">1"),percentage=c(zero_Olfr_percentage,one_Olfr_percentage,more_than_one_Olfr_percentage))
  return(mOSN_df)
}

cutoffs <- c(0:8,16,32,64,128,256)
mOSN_df <- c()
for (i in 1:length(cutoffs)){
  mOSN_df <- calculate_mOSNs_percentage(cutoffs[i]) %>% rbind(mOSN_df, .)
}
mOSN_df$cutoff <- factor(mOSN_df$cutoff,levels=cutoffs)
mOSN_df$Olfr_N <- factor(mOSN_df$Olfr_N,levels=c("0","1",">1"))

newpalette <- c(brewer.pal(8,"Set2")[8],brewer.pal(9,"Blues")[c(5,3)])
pdf(str_c(out_dir,"plots/mOSN_UMI_cutoff_threshold_tunning.pdf"), height = 8, width=9)
ggplot(data=mOSN_df,aes(x=cutoff,y=percentage,color=Olfr_N,group=Olfr_N))+
  geom_point(size=2) +
  geom_line() +
  scale_color_manual(values=newpalette)+
  labs(x="Threshold(# of UMIs)",y="Percent of mOSNs",color="# of ORs")+
  theme_classic()+
  theme(panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        axis.title=element_text(size=rel(2)),
        axis.text.y = element_text(color="black",size=rel(1.8)), 
        axis.text.x = element_text(color="black",size=rel(1.8)),
        axis.line = element_line(colour="black",linewidth=1))
dev.off()

#### 8. Identify single-receptor mOSNs using the selected threshold ####
## A receptor is considered expressed when its SCT count is greater than 3.
mOSN_scRNA <- subset(CCAIntegration_obj, idents = "mOSN")
# An object of class Seurat 
# 54907 features across 64157 samples within 2 assays 
# Active assay: SCT (22622 features, 3000 variable features)
# 3 layers present: counts, data, scale.data
# 1 other assay present: RNA
# 3 dimensional reductions calculated: pca, integrated, umap

mOSN_scRNA$receptor_number <- rowSums(mOSN_olfr_counts > 3) 

mOSN_scRNA$receptor_number_class <- ifelse(mOSN_scRNA$receptor_number > 1, "multiple", mOSN_scRNA$receptor_number)

df <- as.data.frame(table(
  mOSN_scRNA$receptor_number_class,
  mOSN_scRNA$orig.ident
))

colnames(df) <- c("receptor_number_class", "orig.ident", "count")

pdf("integrated_analysis_seuratV5_Datta_data/plots/barplot_receptor_number_proportion_mOSN_UMI_over_3.pdf")
ggplot(df, aes(x = orig.ident, y = count, fill = receptor_number_class)) +
  geom_bar(stat = "identity", position = "fill") +
  scale_y_continuous(labels = percent) +
  theme_classic() +
  labs(x = "Sample", y = "Proportion", fill = "Receptor number") +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, size = 8)
  )
dev.off()

## Retain mOSNs expressing exactly one receptor above the selected threshold.
mOSN_scRNA_single_receptor <- subset(mOSN_scRNA, subset = receptor_number == 1)
mOSN_scRNA_single_receptor
# An object of class Seurat 
# 54450 features across 44745 samples within 2 assays 
# Active assay: SCT (22165 features, 3000 variable features)
# 3 layers present: counts, data, scale.data
# 1 other assay present: RNA
# 3 dimensional reductions calculated: pca, integrated, umap

## Record the receptor detected in each retained mOSN.
mOSN_scRNA_single_receptor$receptor <- apply(
  mOSN_olfr_counts[colnames(mOSN_scRNA_single_receptor), ], 1, function(x) {
    colnames(mOSN_olfr_counts)[which(x > 3)]
  }
)

## Assign each detected receptor to TAAR, class I OR, or class II OR.
## TAAR receptor list
TAAR_info <- receptor_info[grep("Taar", receptor_info$gene_name),]
Taar_name <- TAAR_info$gene_name

## Class I and class II OR receptor lists
ClassI_ClassII_OR_info <- read.csv("/lustre/home/acct-medlqian/medlqian-loop3/database/olfactory_receptor_information/All_ORs_with_OR_clusters_info_by_my_criteria_OR_distance_above_1Mb_Gencode_vM25_New.csv", header = T, row.names = 1)
rownames(ClassI_ClassII_OR_info) <- gsub("\\.ps", "-ps",  rownames(ClassI_ClassII_OR_info))

ClassI_OR_name <- rownames(ClassI_ClassII_OR_info)[which(ClassI_ClassII_OR_info$OR_Class == "Class_I" & ClassI_ClassII_OR_info$gene_type == "protein_coding")]
length(ClassI_OR_name)
