################################################################################
#### 9. Train and evaluate the GLMnet TAAR/OR classifier ####
#### The environment is cleared intentionally so this block can be rerun from
#### the saved single-receptor mOSN object without relying on objects in memory.
################################################################################
rm(list=ls())

# install.packages("glmnet")
library(glmnet)
# 对于每个细胞，模型把一堆基因表达值组合起来，先算一个线性分数

# install.packages("pROC")
library(pROC)

# install.packages("PRROC")
library(PRROC)

##### 9.1 Load the training object and define TAAR/OR labels ####
# 提取WT单细胞数据中的表达单个受体的mOSN
load("integrated_analysis_seuratV5_Datta_data/rdata/mOSN_scRNA_single_receptor.rdata")

# 不区分 class I OR 和 class II OR
mOSN_scRNA_single_receptor$Taar_OR_class <- ifelse(
  mOSN_scRNA_single_receptor$receptor_class == "Taar",
  "Taar",
  "OR"
)

Idents(mOSN_scRNA_single_receptor) <- "Taar_OR_class"

##### 9.2 Create stratified training and test sets ####
set.seed(1)

meta <- mOSN_scRNA_single_receptor@meta.data
meta$cell_id <- rownames(meta)
meta$label <- mOSN_scRNA_single_receptor$Taar_OR_class

## Stratify jointly by sample identity and TAAR/OR label.
meta$strata <- paste(meta$orig.ident, meta$label, sep = "_")

## Sample 80% of cells from each stratum for model training.
train_cells <- unlist(lapply(split(meta$cell_id, meta$strata), function(cells) {
  n <- length(cells)
  
  n_train <- max(1, min(n - 1, floor(0.8 * n)))
  
  return(sample(cells, size = n_train))
}))
# split(meta$cell_id, meta$strata) 这一步是把所有细胞按 meta$strata 分组。
# lapply(..., function(cells) { ... }) 对每一个分组，分别执行后面的抽样函数。

test_cells <- setdiff(meta$cell_id, train_cells)

## Confirm label distributions in both partitions.
table(meta[train_cells, "label"])
# OR  Taar 
# 35330   462 
table(meta[test_cells, "label"])
# OR Taar 
# 8836  117 

##### 9.3 Identify TAAR-versus-OR features using the training set only ####
train_obj <- subset(mOSN_scRNA_single_receptor, cells = train_cells)
Idents(train_obj) <- "Taar_OR_class"
DefaultAssay(train_obj) <- "SCT"
train_obj <- PrepSCTFindMarkers(train_obj)

## Optional acceleration for FindMarkers (not required for the saved results).
# devtools::install_github('immunogenomics/presto')

## p_val_adj 是基于 assay 中全部基因数进行 Bonferroni 校正。
## logfc.threshold、min.pct 等预过滤参数不会改变 Bonferroni 校正的基因总数，
## 但会影响哪些基因被检验并出现在 FindMarkers() 结果中。
## Save the default-parameter result for visualization and comparison.
train_markers <- FindMarkers(
  train_obj,
  ident.1 = "Taar",
  ident.2 = "OR",
  test.use = "wilcox",
  only.pos = FALSE,
  recorrect_umi = FALSE
)
dim(train_markers)
# 7634    5

write.xlsx(
  list(
    train_markers_all = cbind(gene = rownames(train_markers), train_markers)
  ),
  file = "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/Taar_OR_train_only_DE_results_mOSN_expressing_single_receptor_default_parameters.xlsx"
)

train_markers <- FindMarkers(
  train_obj,
  ident.1 = "Taar",
  ident.2 = "OR",
  logfc.threshold = 0.25,
  test.use = "wilcox",
  only.pos = FALSE,
  recorrect_umi = FALSE
)

## Preserve gene symbols as an explicit column.
train_markers$gene <- rownames(train_markers)
dim(train_markers)
# 3913    6

## Retain adjusted P < 0.05 and |log2FC| >= 0.585, then exclude receptor genes.
train_markers_use <- train_markers[which(
  train_markers$p_val_adj < 0.05 & abs(train_markers$avg_log2FC) >= 0.585),
]
dim(train_markers_use)
# 278   6

train_markers_use <- train_markers_use[
  !grepl("Taar|Olfr", train_markers_use$gene),
]

dim(train_markers_use)
# 267   6

## Save the complete and filtered training-set DEG tables.
write.xlsx(
  list(
    train_markers_all = cbind(gene = rownames(train_markers), train_markers),
    train_markers_filtered = train_markers_use
  ),
  file = "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/files/Taar_OR_train_only_DE_results_mOSN_expressing_single_receptor.xlsx"
)

##### 9.4 Extract the normalized expression matrix ####
mat <- GetAssayData(mOSN_scRNA_single_receptor, assay = "SCT", layer = "data")

train_markers_use <- read.xlsx("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/files/Taar_OR_train_only_DE_results_mOSN_expressing_single_receptor.xlsx",
                               sheet = "train_markers_filtered")

features <- train_markers_use$gene

features <- intersect(features, rownames(mat))
features_exclude_Tbr1 <- features[-which(features == "Tbr1")]

##### 9.5 Construct training and test feature matrices ####
# 把表达矩阵变成 cells × genes，符合 glmnet 输入格式
x1_train <- t(as.matrix(mat[features_exclude_Tbr1, train_cells]))
x1_test  <- t(as.matrix(mat[features_exclude_Tbr1, test_cells]))

## Remove genes with zero variance in the training set and apply the same filter
## to the test matrix.
keep <- apply(x1_train, 2, function(z) sd(z) > 0)
table(keep)
# keep
# TRUE 
# 266
x1_train <- x1_train[, keep, drop = FALSE]
x1_test  <- x1_test[, keep, drop = FALSE]

dim(x1_train)
# 35792   266

##### 9.6 Encode binary response labels ####
y_train <- ifelse(meta[train_cells, "label"] == "Taar", 1, 0)
y_test  <- ifelse(meta[test_cells, "label"] == "Taar", 1, 0)

table(y_train)
# y_train
# 0     1 
# 35330   462 

table(y_test)
# y_test
# 0    1 
# 8836  117

##### 9.7 Train the cross-validated binomial LASSO model ####
cvfit1 <- cv.glmnet(
  x = x1_train,
  y = y_train,
  family = "binomial",
  alpha = 1,
  nfolds = 5
)
# x：训练特征矩阵，cells × genes
# y：0/1 标签
# family = "binomial"：二分类逻辑回归
# alpha = 1：LASSO（L1 惩罚）
# nfolds = 5：5 折交叉验证

cvfit1
# Call:  cv.glmnet(x = x1_train, y = y_train, nfolds = 5, family = "binomial",      alpha = 1) 
# 
# Measure: Binomial Deviance 
# 
# Lambda Index Measure       SE Nonzero
# min 0.0002194    55 0.02454 0.001619     170
# 1se 0.0003833    49 0.02582 0.001621     138

## Save both the fitted model and the feature metadata required for reuse.
saveRDS(cvfit1, "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/rdata/TAAR_OR_glmnet_model_without_Tbr1.rds")

cvfit1 <- readRDS("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/rdata/TAAR_OR_glmnet_model_without_Tbr1.rds")
model_info1 <- list(
  model = cvfit1,
  features = colnames(x1_train),   # 最好直接保存训练矩阵列名
  lambda_use = "lambda.1se",
  assay = "SCT",
  layer = "data"
)

saveRDS(model_info1, "integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/rdata/TAAR_OR_glmnet_model_info_without_Tbr1.rds")
model_info1 <- readRDS("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/rdata/TAAR_OR_glmnet_model_info_without_Tbr1.rds")

## Extract the intercept and gene coefficients at lambda.1se.
coef_mat1 <- coef(cvfit1, s = "lambda.1se")
# lambda.min：交叉验证误差最小的那个 lambda
# lambda.1se：在“误差不比最小值明显差”的前提下，选择的更大、更保守的 lambd
# s = "lambda.1se"：使用更保守的 lambda。

coef_df1 <- data.frame(
  gene = rownames(coef_mat1),
  coef = as.numeric(coef_mat1)
)

coef_df1_only_coef_not_0 <- coef_df1 %>% 
  filter(coef != 0)

