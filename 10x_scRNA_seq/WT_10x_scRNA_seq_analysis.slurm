################################################################################################################
# cellranger
################################################################################################################
# The BAM-to-FASTQ and Cell Ranger blocks below were submitted as two separate
# SLURM jobs. They are shown together here to document the complete upstream
# workflow used to regenerate gene-cell count matrices from the downloaded BAMs.

#### 1. Convert the six original position-sorted BAM files to FASTQ ####
#!/bin/bash
#SBATCH --job-name=bamToFastq
#SBATCH --partition=cpu
#SBATCH -n 10
#SBATCH --output=%j.out
#SBATCH --error=%j.err

module load miniconda3
module load samtools

# Convert homecage_1 through homecage_6. Each sample is written to a separate
# output directory under original_bam_to_fastq/.
for i in `seq 1 6`;
do
    bamtofastq_linux --nthreads 10 \
    original_bam/homecage_${i}_possorted_genome_bam.bam \
    original_bam_to_fastq/homecage_${i}     
done

#### 2. Generate gene-cell count matrices with Cell Ranger ####
# This block is a representative command for homecage_1 and was submitted as a
# separate SLURM job from the BAM-to-FASTQ block above.
#!/bin/bash
#SBATCH --job-name=cellranger
#SBATCH --partition=cpu
#SBATCH -n 10
#SBATCH --output=%j.out
#SBATCH --error=%j.err

input_dir=/lustre/home/acct-medlqian/medlqian-loop3/raw_data_backup/single_cell_RNA_Seq/GSE173947_SandeepRobertDatta_Cell_2021/original_bam_to_fastq/
output_dir=/lustre/home/acct-medlqian/medlqian-loop3/raw_data_backup/single_cell_RNA_Seq/GSE173947_SandeepRobertDatta_Cell_2021/original_bam_to_fastq_to_cellranger/
reference_dir=/lustre/home/acct-medlqian/medlqian-loop3/database/Mus_musculus/GRCm38_mm10/cellranger/refdata-gex-mm10-2020-A/

## Generate the single-cell gene-expression count matrix with cellranger count.
cd ${output_dir}

# homecage_1 contained FASTQs from two sequencing runs; both directories were
# provided together to the same Cell Ranger run.
cellranger count --id=homecage_1 \
--fastqs=${input_dir}homecage_1/baseline-1_0_1_HM3C5DSXY/,${input_dir}homecage_1/baseline-1_0_1_HM533DSXY/ \
--sample=bamtofastq \
--transcriptome=${reference_dir} \
--localcores=10 --localmem=40

# homecage_2 through homecage_6 were processed using the same Cell Ranger
# workflow with their corresponding sample-specific FASTQ directories and IDs.

################################################################################################################
# seurat analysis
################################################################################################################
# The downstream Seurat analysis was performed in R. The code below is R code
# and is separate from the Bash/SLURM commands used for upstream processing.
#### GSE173947 scRNA-seq processing and TAAR/OR classifier training ####
####
#### This script processes six GSE173947 home-cage samples, identifies mature
#### olfactory sensory neurons (mOSNs) expressing a single receptor, and trains
#### GLMnet and linear SVM classifiers to distinguish TAAR from OR neurons.
#### Run the script sequentially because later sections use objects and files
#### generated by earlier sections. Output subdirectories are created manually.
#### Cell-level QC: nFeature_RNA >= 400, nCount_RNA >= 700, percent.mt < 10.
####
rm(list=ls())

#### 1. Initialize the R environment and load packages ####
.libPaths(new = "/lustre/home/acct-medlqian/medlqian-loop3/R/x86_64-redhat-linux-gnu-library/4.2.2")

library(Seurat)
library(ggplot2)
library(dplyr)
library(stringr)
library(RColorBrewer)
library(patchwork)
library(Matrix)
library(ComplexUpset)
library(openxlsx)
library(scales)
library(glmnet)
library(pROC)
library(PRROC)
library(LiblineaR)
library(tidyr)

setwd("/lustre/home/acct-medlqian/medlqian-loop3/data/10X_sc_RNA_Seq/20250518_WT_10X_scRNA_Seq_seurat_analysis")

set.seed(42)

#### 2. Read raw 10x matrices and perform cell-level QC ####
## Define the main output directory. Required subdirectories are prepared manually.
out_dir <- "/lustre/home/acct-medlqian/medlqian-loop3/data/10X_sc_RNA_Seq/20250518_WT_10X_scRNA_Seq_seurat_analysis/integrated_analysis_seuratV5_Datta_data/"
if(!file.exists(out_dir)){
  dir.create(file.path(out_dir))
}

## Read the six GSE173947 home-cage datasets as separate Seurat objects.
GSE173947_samples <- paste("GSE173947_homecage",1:6,sep="_")
GSE173947_scRNA_dirs <- str_c("/lustre/home/acct-medlqian/medlqian-loop3/data/10X_sc_RNA_Seq/20250518_WT_10X_scRNA_Seq_seurat_analysis/GSE173947_SandeepRobertDatta_Cell_2021/raw_data/", GSE173947_samples)

objList <- lapply(1:length(GSE173947_scRNA_dirs),function(i){
  CreateSeuratObject(counts = Read10X(GSE173947_scRNA_dirs[i]),
                     project = GSE173947_samples[i],assay = "RNA") 
})

for ( i in 1:length(objList)){
  objList[[i]][["percent.mt"]] = PercentageFeatureSet(objList[[i]], pattern="^mt-")
}

## The following optional block visualizes QC distributions before filtering.

# for ( i in 1:length(objList)){
#   meta <- objList[[i]]@meta.data
#   pdf(str_c("integrated_analysis_seuratV5_Datta_data/plots/", GSE173947_samples[i],"_qc_plot.pdf"), width=10, height = 8)
#   # 1. Violin plot (Seurat)
#   p1=VlnPlot(objList[[i]],features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
#   # 2. density plots
#   p2=ggplot(data=meta,aes(x=nFeature_RNA))+geom_density()+ theme_classic()
#   p3=ggplot(data=meta,aes(x=nCount_RNA))+geom_density()+ theme_classic()
#   p4=ggplot(data=meta,aes(x=percent.mt))+geom_density()+ theme_classic()
#   # 3. scatter plots
#   p5=FeatureScatter(objList[[i]], feature1 = "nCount_RNA", feature2 = "percent.mt")
#   p6=FeatureScatter(objList[[i]], feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
#   print(p1)
#   print(p2)
#   print(p3)
#   print(p4)
#   print(p5)
#   print(p6)
#   dev.off()
# }

for (i in 1:length(objList)){
  objList[[i]] <- subset(objList[[i]],subset = nFeature_RNA >= 400 & 
                           nCount_RNA >= 700  & percent.mt < 10)
}

save(objList,file = "integrated_analysis_seuratV5_Datta_data/rdata/objList.rdata")

#### 3. Normalize, integrate, and reduce dimensionality ####
## Merge samples, apply SCTransform while regressing mitochondrial percentage,
## and calculate the first 50 principal components.
merged_obj <- merge(
  x = objList[[1]],
  y = objList[2:6],
  add.cell.ids = GSE173947_samples
)

merged_obj <- SCTransform(merged_obj, vars.to.regress = c("percent.mt")) %>% 
  RunPCA(npcs = 50)

save(merged_obj,file = "integrated_analysis_seuratV5_Datta_data/rdata/merged_obj.rdata")

ElbowPlot(merged_obj, ndims = 50)

## Integrate sample-specific layers using CCA in the SCT assay.
CCAIntegration_obj <- IntegrateLayers(
  object = merged_obj,
  method = CCAIntegration,
  assay = "SCT",
  normalization.method = "SCT",
  orig.reduction = "pca",
  new.reduction = "integrated",
  verbose = TRUE
)

save(CCAIntegration_obj, file = "integrated_analysis_seuratV5_Datta_data/rdata/CCAIntegration_obj_step1.rdata")

#### 4. Select the number of principal components ####
load("integrated_analysis_seuratV5_Datta_data/rdata/CCAIntegration_obj_step1.rdata")

## The elbow plot summarizes the contribution of each PC to total variance.
pdf("integrated_analysis_seuratV5_Datta_data/plots/ElbowPlot.pdf")
ElbowPlot(CCAIntegration_obj, ndims = 50)
dev.off()

## Marker panels are used to compare clustering solutions across PC numbers.
markers <- c( # OE
  "Syt1", "Syp", "Snap25", "Vamp2", # neurons
  "Nqo1","Ncam2", # dorsal/ventral OSNs
  "Omp", "Gnal","Adcy3", "Slc17a6", "Cnga4", "Cnga2",  "Gng13", "Cngb1", "Rtp1", # Mature OSNs
  "Gap43", "Gng8", "Stmn1", "Stmn2", "Dpysl3", "Dpysl5", "Crmp1", "Atf5", "Ablim1", "Dbn1", "Marcksl1", #Immature OSNs
  "Neurog1", "Neurod1", "Tex15", "Sox11", "Lhx2", "Ebf1",  #INPs, immediate neuronal precursors
  "Ascl1", "Kit", "Lgr5", "Sox2", "Hes6", "Cxcr4", "Tmprss4",  #GBCs
  "Top2a", "Mki67", "Ezh2",  #cycling GBCs
  "Krt5", "Krt14", "Trp63", #HBCs
  "Ms4a4c", "Ms4a6c", "Pde2a", "Car2", "Cnga3", # Ms4a-expressing chemosensory receptor cell (Ms4)
  "Sox2", "Ermn", "Cyp2g1", "Cyp1a2", "Sult1c1","Notch2", "Hes1", "Hes5", "Gpx6", "Hey1",  # Sustentacular cells
  "Coch", "Ascl3", "Cftr", "Foxi1","Hepacam2", # olfactory microvillar cells (Trpm5-)
  "Sox9", "Trpm5", "Pou2f3", "Chat", "Avil", "Il25", "Ltc4s", # mv (Trpm5+)
  
  # 固有层 (lamina propria)
  "Atp1a2", "Fabp7", "S100b", "Plp1", "Mpz", "Alx3", # Ensheathing glia
  "Sox9","Sox10", "Krt18", "Muc5ac", "Gpx3", # Bowman's gland
  "Pdgfrb", "Rgs5", "Cspg4", # Vascular wall cells: Pericytes
  "Tagln", "Acta2", "Myh11", # Vascular wall cells: vascular smooth muscle cell 
  "Pecam1", "Kdr", "Cdh5", # Endothelial cells
  "Col1a1", "Col1a2", "Dcn", # Fibroblasts
  
  # respiratory epithelium
  "Krt5", "Krt14", "Trp63", # Respiratory basal cells
  "Foxj1", "Pifo", "Tubb4b", # respiratory ciliated cells
  "Muc5ac", "Tff3", "Cyp4b1", # Respiratory secretory cells
  
  ## Blood cells (Immune cells + red blood cells)
  # Immune cells
  "Cd3d", "Cd3e","Trac",  # t cell
  "Cd37", "Cd19", "Cd79a", # b cell
  "Mzb1", "Sdc1", "Jchain", # plasma cell
  "Nkg7", "Prf1", "Gzmb", # natural killer cell
  "S100a8", "S100a9", "Cxcr2", # Neutrophils
  "Lyz2", "Tyrobp", "Aif1", # Myeloid_cells 髓系细胞，可粗略包括 monocytes、macrophages、dendritic cells
  
  # Erythrocytes / red blood cells
  "Hba-a1", "Hbb-bs", "Hbb-bt",# Erythrocytes
  
  "Col1a1","Bglap" #Osteogenic cells
)

markers <- markers[markers %in% rownames(CCAIntegration_obj)]
all(markers %in% rownames(CCAIntegration_obj))
unique_markers <- unique(markers)

for (nPCs in seq(15,40,5)){
  CCAIntegration_obj <- FindNeighbors(CCAIntegration_obj, dims = 1:nPCs, reduction = "integrated")
  CCAIntegration_obj <- FindClusters(CCAIntegration_obj, resolution = 0.1)
  CCAIntegration_obj <- RunUMAP(CCAIntegration_obj, dims = 1:nPCs, reduction = "integrated", reduction.name = "umap")
  
  DefaultAssay(CCAIntegration_obj) <- "SCT"
  pdf(str_c(out_dir,"plots/integrated_scRNA_PC",nPCs,"_resolution0.1_UMAP.pdf"))
  p1 <- DimPlot(CCAIntegration_obj, reduction = "umap", label=TRUE, raster=FALSE) + 
    theme(legend.position = "bottom")
  p2 <- DimPlot(CCAIntegration_obj, reduction = "umap", group.by="orig.ident", raster=FALSE) + 
    theme(legend.position = "bottom")
  print(p1)
  print(p2)
  dev.off()
  
  DefaultAssay(CCAIntegration_obj) <- "SCT"
  pdf(str_c(out_dir,"plots/integrated_scRNA_PC",nPCs,"_markers_featureplot.pdf"))
  p <- FeaturePlot(CCAIntegration_obj, reduction = "umap", features=unique_markers, 
                   combine=F, cols=c("lightgrey", "red"), order=TRUE, raster=FALSE)
  print(p)
  dev.off()
}

#### 5. Select the clustering resolution ####
## The final analysis uses 30 PCs and resolution 0.4; the loop records alternative
## resolutions for visual comparison.
CCAIntegration_obj <- FindNeighbors(CCAIntegration_obj, reduction = "integrated", dims = 1:30)
CCAIntegration_obj <- RunUMAP(CCAIntegration_obj, dims = 1:30, 
                              reduction = "integrated", reduction.name = "umap")

resolutions <- seq(0.2, 1.5, by = 0.1)
for (res in resolutions) {
  CCAIntegration_obj <- FindClusters(CCAIntegration_obj, resolution = res)
  
  pdf(str_c(out_dir,"plots/integrated_scRNA_PC30_resolution",res,"_UMAP.pdf"))
  p1 <- DimPlot(CCAIntegration_obj, reduction = "umap", label=TRUE, 
                group.by=str_c("SCT_snn_res.", res))
  p2 <- DimPlot(CCAIntegration_obj, reduction = "umap", group.by="orig.ident")
  print(p1)
  print(p2)
  dev.off()
  
  pdf(width = 15, height = 80, str_c(out_dir,"plots/integrated_scRNA_PC30_resolution", res,"_vlnplot_marker.pdf"))
  p1 <- VlnPlot(CCAIntegration_obj, group.by=str_c("SCT_snn_res.", res),
                features = unique_markers, pt.size = 0) & 
    xlab(NULL) & ylab(NULL)
  print(p1)
  dev.off()
  
  pdf(width = 24, height = 20, str_c(out_dir,"plots/integrated_scRNA_PC30_resolution",res,"_dotplot_marker.pdf"))
  p2 <- DotPlot(CCAIntegration_obj, group.by=str_c("SCT_snn_res.", res), 
                features = rev(unique_markers), 
                cols = c("lightgrey", "dodgerblue3")) + 
    RotatedAxis()+
    coord_flip () 
  print(p2)
  dev.off()
}

#### 6. Annotate cell types and summarize cluster composition ####
CCAIntegration_obj$seurat_clusters <- CCAIntegration_obj$SCT_snn_res.0.4
Idents(CCAIntegration_obj) <- "SCT_snn_res.0.4"

# 要删除的 resolution 列
cols_remove <- paste0("SCT_snn_res.", c(seq(0.1, 0.3, by = 0.1), seq(0.5, 1.5, by = 0.1)))

# 只删除实际存在的列，避免报错
cols_remove <- intersect(cols_remove, colnames(CCAIntegration_obj@meta.data))

# 删除
CCAIntegration_obj@meta.data[, cols_remove] <- NULL

# 检查是否删除成功
grep("^SCT_snn_res", colnames(CCAIntegration_obj@meta.data), value = TRUE)

