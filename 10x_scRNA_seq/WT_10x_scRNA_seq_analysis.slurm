pr <- pr.curve(
  scores.class0 = prob_test1[y_test == 1],
  scores.class1 = prob_test1[y_test == 0],
  curve = TRUE
)
round(pr$auc.integral, 3)

pr_df <- data.frame(
  recall = pr$curve[, 1],
  precision = pr$curve[, 2]
)

pdf("integrated_analysis_seuratV5_Datta_data/TAAR_OR_OSN_identifier_model/GLM_model_pr_curve.pdf")
